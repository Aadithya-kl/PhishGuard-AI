# =============================================================================
# PhishGuard AI — environment configuration
#   cp .env.example .env   and fill in every REQUIRED value.
# =============================================================================

# --- Application -------------------------------------------------------------
ENVIRONMENT=production            # production | development
PUBLIC_URL=http://localhost:3000  # the URL users open in the browser
FRONTEND_PORT=3000
COOKIE_SECURE=true                # set false ONLY for plain-http testing on a non-localhost host
ALLOW_PUBLIC_REGISTRATION=false   # users join via admin invitations
LOG_LEVEL=info

# --- REQUIRED secrets ---------------------------------------------------------
# Generate each with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# --- Database (only used by docker-compose) ----------------------------------
POSTGRES_USER=phishguard
POSTGRES_DB=phishguard

# --- Auth tuning --------------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=12
LOGIN_MAX_FAILURES=10
LOGIN_LOCKOUT_MINUTES=15

# --- Limits -------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=10
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_SCAN_PER_MINUTE=20

# --- AI analysis --------------------------------------------------------------
# gemini | ollama | heuristic   (heuristic = fully offline, no API key needed)
LLM_PROVIDER=heuristic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# --- Threat intelligence (all optional) --------------------------------------
VIRUSTOTAL_API_KEY=
SAFEBROWSING_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=
PHISHTANK_API_KEY=

# --- Observability ------------------------------------------------------------
METRICS_TOKEN=                    # set to enable /metrics with "Authorization: Bearer <token>"
FLOWER_BASIC_AUTH=                # user:password — required to start the Flower profile
